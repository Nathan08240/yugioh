# Copier en server/.env (ignoré par git) et remplir.
# Connexion en tant que yugioh_server : postgres://yugioh_server:<mot de passe>@<hôte>:5432/postgres
YUGIOH_DATABASE_URL=
SUPABASE_URL=https://supabase.nbrcs.pro
SUPABASE_ANON_KEY=
PORT=3001
# Comptes (id Supabase, séparés par des virgules) qui voient le bouton pour s'ajouter des boosters.
ADMIN_USER_IDS=
